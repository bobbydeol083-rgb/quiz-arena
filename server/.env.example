# --- Server ---
PORT=5000
NODE_ENV=development          # development | test | production
CLIENT_URL=*                  # comma-separated origins for REST CORS, e.g. https://app.example.com

# --- MongoDB ---
MONGO_URI=mongodb://127.0.0.1:27017/quizarena

# --- Auth (JWT) ---
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# --- Logging ---
LOG_LEVEL=debug               # debug | info | warn | error
